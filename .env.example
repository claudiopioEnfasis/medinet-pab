# Plantilla: no contiene credenciales utilizables. No subir .env a GitHub.
# Actualización v0.3 -> v0.5: conservar TODOS los valores del .env anterior.
# No copiar esta plantilla encima de un .env existente ni cambiar la contraseña
# de un volumen inicializado: POSTGRES_PASSWORD no modifica el usuario de la BD.
# Credenciales administrativas; no se entregan al backend.
POSTGRES_USER=medinet_admin
POSTGRES_DB=medinet_pab
POSTGRES_PASSWORD=
# Obligatorio: al menos 32 caracteres. Conservar la clave anterior si ya existe.
# Solo si falta, generar localmente con: openssl rand -hex 32
# Usar comillas simples para valores que contengan $ o #.
JWT_SECRET=

# Solo para compose.prod.yaml; no hacen falta para compose.yaml local.
# Prefijo sin -api/-web/-db, por ejemplo ghcr.io/organizacion/medinet-pab.
IMAGE_PREFIX=
# Etiqueta publicada por CI: sha-<commit completo>.
IMAGE_TAG=
# DB_HOST=db lo define Compose; no es necesario añadirlo aquí.

# .env.runtime se genera con bash scripts/provision_runtime.sh.
# Contiene la conexión restringida y nunca se versiona. No copiar .env sobre él.
